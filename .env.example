# GitHub Dev Card Generator — Environment Variables

# Required: Your Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional but recommended: GitHub personal access token (public_repo scope)
# Raises API rate limit from 60 to 5000 requests/hour
# Get one at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Optional: Google Cloud project ID (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Backend URL (used by frontend Docker container)
BACKEND_URL=http://localhost:8080

# Optional: Vertex AI Agent Engine ID (for Memory Bank bonus)
AGENT_ENGINE_ID=
