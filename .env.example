# GitHub & LinkedIn Dev Card Generator — Environment Variables Template

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Your Groq API key (get one at https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── SCRAPING API KEYS ──────────────────────────────────────────────────────────
# Optional but highly recommended: GitHub personal access token (public_repo scope)
# Raises API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=ghp_your_token_here

# Optional: Apify API Token (used for real-time LinkedIn scraping via HarvestAPI)
# Get a free token at https://apify.com/
APIFY_API_TOKEN=apify_api_your_token_here

# Optional: Proxycurl API Key (fallback LinkedIn scraper)
PROXYCURL_API_KEY=your_proxycurl_key_here

# ── CONFIGURATION & DEPLOYMENT ────────────────────────────────────────────────
# Backend URL - Set to 'http://localhost:8080' for local dev, or your Cloud Run URL in production
BACKEND_URL=http://localhost:8080

# Session Secret Key - Set to a random 32-character string to encrypt session cookies securely
SESSION_SECRET_KEY=change-me-to-a-random-secret-key-32-chars-min

# ── OAUTH CREDENTIALS (LOCAL vs PRODUCTION SETUP) ─────────────────────────────
# Note: For GitHub, create two separate OAuth Apps (one for local, one for production).
# For GitLab and LinkedIn, you can use a single app and add both redirect URIs.

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitLab OAuth App Credentials
GITLAB_CLIENT_ID=your_gitlab_client_id_here
GITLAB_CLIENT_SECRET=your_gitlab_client_secret_here

# LinkedIn OAuth App Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
